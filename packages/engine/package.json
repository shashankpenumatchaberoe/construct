    "./envelope": "./envelope.mjs",
    "./pipeline": "./pipeline.mjs",
    "./workflow-generator": "./workflowGenerator.mjs",
    "./controller-binder": "./controllerBinder.mjs",
    "./page-transformer": "./pageTransformer.mjs",
    "./default-enforcers": "./defaultEnforcers.mjs",
    "./workflow-narrator": "./workflowNarrator.mjs",
    "./workflow-scenarios": "./workflowScenarios.mjs",
    "./workflow-explain": "./workflowExplain.mjs",
    "./workflow-source": "./workflowSource.mjs",
    "./workflow-editor": "./workflowEditor.mjs",
    "./workflow-context": "./workflowContext.mjs",
    "./unit-summary": "./unitSummary.mjs",
    "./scope-links": "./scopeLinks.mjs",
    "./jsx-source-annotator": "./jsxSourceAnnotator.mjs",
    "./preview-bridge": "./previewBridge.mjs",
    "./preview-vite-plugin": "./previewVitePlugin.mjs",
    "./process-machine": "./processMachine.mjs",
    "./process-model": "./processModel.mjs",
    "./process-store": "./processStore.mjs",
    "./process-engine": "./processEngine.mjs",
    "./commit-message": "./commitMessage.mjs",
    "./pr-health": "./prHealth.mjs",
    "./git-trees": "./gitTrees.mjs",
    "./package.json": "./package.json"
