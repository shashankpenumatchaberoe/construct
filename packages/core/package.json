{
  "name": "@line/construct-core",
  "version": "0.9.0",
  "description": "Construct's deterministic, non-LLM core: config/architecture rules, generators, the plan/validate/summarize/impact engine. No CLI (see @line/construct), no UI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./cli.mjs",
    "./plan": "./plan.mjs",
    "./block-contract": "./block-contract.mjs",
    "./block-flows": "./block-flows.mjs",
    "./chooser": "./chooser.mjs",
    "./config": "./config.mjs",
    "./placement": "./placement.mjs",
    "./decision-provider": "./decision-provider.mjs",
    "./decision-plugin": "./decision-plugin.mjs",
    "./decision-project": "./decision-project.mjs",
    "./machine": "./machine.mjs",
    "./decision-trace": "./decision-trace.mjs",
    "./decision-trace-store": "./decision-trace-store.mjs",
    "./decision-trace-adapters": "./decision-trace-adapters.mjs",
    "./decision-trace-replay": "./decision-trace-replay.mjs",
    "./decision-dataset": "./decision-dataset.mjs",
    "./decision-features": "./decision-features.mjs",
    "./decision-prototypes": "./decision-prototypes.mjs",
    "./decision-model-bundle": "./decision-model-bundle.mjs",
    "./decision-model-registry": "./decision-model-registry.mjs",
    "./redaction": "./redaction.mjs",
    "./requirement-card": "./requirement-card.mjs",
    "./requirement-lexicon": "./requirement-lexicon.json",
    "./validate": "./validate.mjs",
    "./summarize": "./summarize.mjs",
    "./backend-summary": "./backend-summary.mjs",
    "./impact": "./impact.mjs",
    "./generate": "./generators.mjs",
    "./llm": "./llm.mjs",
    "./text-diff": "./text-diff.mjs",
    "./diagnostics": "./diagnostics.mjs",
    "./dir-browser": "./dir-browser.mjs",
    "./file-change-tracker": "./file-change-tracker.mjs",
    "./typed-contracts": {
      "types": "./typed-contracts/index.ts",
      "default": "./typed-contracts/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "!*.test.mjs",
    "requirement-lexicon.json",
    "research/",
    "typed-contracts/*.ts",
    "typed-contracts/*.d.ts"
  ],
  "dependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "diff": "^9.0.0",
    "js-yaml": "^4.3.2",
    "minimatch": "^10.0.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
